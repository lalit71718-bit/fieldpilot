# ---------- LLM (any OpenAI-compatible API: OpenAI, Groq, Gemini-openai, OpenRouter) ----------
# Groq (free, fast). Free tier = ~8k tokens/min PER MODEL, so list fallbacks:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Google Gemini (free key, no card: aistudio.google.com/apikey):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash      LLM_FALLBACK_MODELS=gemini-2.5-flash-lite
# Optional 2nd provider, used when all models above are rate-limited.
# Cerebras free tier (cloud.cerebras.ai) has much higher limits than Groq free:
LLM2_BASE_URL=https://api.cerebras.ai/v1
LLM2_API_KEY=
LLM2_MODELS=gpt-oss-120b
# OpenAI instead: LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini

# ---------- Agora (console.agora.io) ----------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# RESTful API credentials: Console -> Developer Toolkit -> RESTful API -> Add secret
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_CHANNEL=fieldpilot-demo
# ASR language for the agent
AGORA_ASR_LANGUAGE=en-US

# ---------- Public URL of THIS backend (Agora cloud calls it; localhost will NOT work) ----------
# e.g. run: cloudflared tunnel --url http://localhost:8000   or   ngrok http 8000
PUBLIC_BASE_URL=https://xxxx.trycloudflare.com
# Shared secret Agora sends as "Authorization: Bearer ..." to our /chat/completions
BRAIN_API_KEY=change-me

# ---------- Murf Falcon TTS (murf.ai -> API keys) ----------
MURF_API_KEY=
# Voice name from the Murf voice library, e.g. Matthew, Gordon
MURF_VOICE_ID=Matthew
MURF_LOCALE=en-US
MURF_MODEL=FALCON
# Optional: replace the whole Murf "params" block (see docs.agora.io/en/ai/models/tts/murf)
# AGORA_TTS_PARAMS_JSON={"api_key":"...","voiceId":"Matthew","model":"FALCON","locale":"en-US"}

# ---------- Integrations (optional: without them actions are logged to the dashboard only) ----------
SLACK_WEBHOOK_URL=
